# Supabase Configs
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_PLATFORM=vertex_ai

# Google Cloud Vertex AI / Agent Platform Credentials
GOOGLE_APPLICATION_CREDENTIALS=path-to-your-downloaded-project-json-file
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Africa's Talking API (Kenyan SMS/WhatsApp gateway)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your-at-api-key
AFRICAS_TALKING_SENDER_ID=your-short-code

# Africa's Talking Delivery Receipt Webhook Shared Secret (optional hardening — enables x-at-webhook-secret validation)
AT_DELIVERY_WEBHOOK_SECRET=your-at-delivery-webhook-secret

# Supabase Auth Webhook Shared Secret
SUPABASE_SMS_WEBHOOK_SECRET=your-supabase-sms-webhook-secret-token

# Application settings
MAX_SMS_FAN_OUT=500
ENCRYPTION_KEY=32-byte-base64-encoded-key-for-profile-aes-encryption=
API_SECRET_TOKEN=your-cloud-scheduler-auth-token-for-scrape

# Optional LlamaParse
LLAMAPARSE_API_KEY=your-llamaparse-api-key
