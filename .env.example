# ===========================================================================
# HUSTLEYETU — ROOT ENVIRONMENT CONFIGURATION
# Copy this file to .env at the root or split into backend/.env and frontend/.env.local
# ===========================================================================

# ---------------------------------------------------------------------------
# BACKEND SETTINGS (backend/.env)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

GEMINI_API_KEY=your-gemini-api-key

AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your-at-api-key
AFRICAS_TALKING_SENDER_ID=your-short-code

SUPABASE_SMS_WEBHOOK_SECRET=your-supabase-sms-webhook-secret-token
AT_DELIVERY_WEBHOOK_SECRET=your-at-delivery-webhook-secret

MAX_SMS_FAN_OUT=500
ENCRYPTION_KEY=32-byte-base64-encoded-key-for-profile-aes-encryption=
API_SECRET_TOKEN=your-cloud-scheduler-auth-token-for-scrape

# Optional LlamaParse (for advanced PDF parsing in Phase 2)
LLAMAPARSE_API_KEY=your-llamaparse-api-key

# ---------------------------------------------------------------------------
# FRONTEND SETTINGS (frontend/.env.local)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
