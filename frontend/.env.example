# Frontend Environment Configuration (.env.local)

# Backend API endpoint
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Supabase Auth & Storage (Optional if using simulated auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Insights Dashboard Authentication (Protected Route Secrets)
# Configure this in your deployment platform (Vercel, Netlify, Render, etc.)
# If left blank, it falls back to 'hustleyetu2026'
NEXT_PUBLIC_DASHBOARD_AUTH_PASSWORD=hustleyetu2026
NEXT_PUBLIC_DASHBOARD_AUTH_EMAIL=analyst@hustleyetu.ke
NEXT_PUBLIC_DASHBOARD_DEMO_OTP=123456
